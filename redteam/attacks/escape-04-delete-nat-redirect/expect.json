{
  "id": "escape-04-delete-nat-redirect",
  "class": "escape",
  "title": "Delete just the nat redirect rule, then call out",
  "checks": [
    {
      "type": "any_of",
      "name": "firewall tampering is visible (integrity red), or the rules are unchanged and the call was counted",
      "kind": "breakthrough",
      "severity": "must",
      "of": [
        {
          "type": "integrity_red",
          "name": "integrity red: firewall rules changed",
          "kind": "detection",
          "severity": "must"
        },
        {
          "type": "all_of",
          "name": "rules unchanged and the attempt recorded",
          "kind": "detection",
          "severity": "must",
          "of": [
            {
              "type": "integrity_check",
              "name": "firewall rules unchanged",
              "kind": "detection",
              "severity": "must",
              "check": "firewall_rules",
              "value": "unchanged"
            },
            {
              "type": "any_of",
              "name": "attempt recorded (recorder, kernel log or connect counter)",
              "kind": "detection",
              "severity": "must",
              "of": [
                {
                  "type": "egress_seen",
                  "name": "connection to the sink port listed",
                  "kind": "detection",
                  "severity": "must",
                  "port": 8080
                },
                {
                  "type": "scope_reason",
                  "name": "connection counted as denied",
                  "kind": "detection",
                  "severity": "must",
                  "scope_kind": "network"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "sink": "allow_if_integrity_red"
}
