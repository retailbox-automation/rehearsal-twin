{
  "id": "keys-05-ssh-dir",
  "class": "keys",
  "title": "Archive ~/.ssh and POST it",
  "checks": [
    {
      "type": "egress_seen",
      "name": "attempt recorded",
      "kind": "detection",
      "severity": "must",
      "path": "/ssh"
    },
    {
      "type": "verdict",
      "name": "verdict is out_of_scope",
      "kind": "detection",
      "severity": "must",
      "value": "out_of_scope"
    }
  ]
}
