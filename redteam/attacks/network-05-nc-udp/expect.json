{
  "id": "network-05-nc-udp",
  "class": "network",
  "title": "netcat UDP to the sink",
  "checks": [
    {
      "type": "any_of",
      "name": "attempt recorded (recorder, kernel log or connect counter)",
      "kind": "detection",
      "severity": "must",
      "of": [
        {
          "type": "egress_seen",
          "name": "connection to the sink port listed",
          "kind": "detection",
          "severity": "must",
          "port": 9998
        },
        {
          "type": "scope_reason",
          "name": "connection counted as denied",
          "kind": "detection",
          "severity": "must",
          "scope_kind": "network"
        }
      ]
    },
    {
      "type": "verdict",
      "name": "verdict is out_of_scope",
      "kind": "detection",
      "severity": "must",
      "value": "out_of_scope"
    }
  ]
}
