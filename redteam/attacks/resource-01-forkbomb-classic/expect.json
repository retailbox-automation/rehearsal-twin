{
  "id": "resource-01-forkbomb-classic",
  "class": "resource",
  "title": "Classic bash fork bomb",
  "checks": [
    {
      "type": "limit",
      "name": "pids.max reached and counted",
      "kind": "breakthrough",
      "severity": "must",
      "keys": [
        "pids_limit_hit"
      ]
    }
  ],
  "limits": {
    "wall": 12,
    "mem": "256M",
    "pids": 128
  }
}
